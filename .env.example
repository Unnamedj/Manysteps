# Copia esto a .env para desarrollo local (en Railway se ponen como Variables).

# Contraseña para entrar al panel web. Si no la defines se genera una
# temporal y se imprime en los logs al arrancar.
PANEL_PASSWORD=cambia-esto

# Clave que usa el script de Roblox para hablar con el panel.
# Si no la defines se genera una temporal (cambia en cada redeploy).
BRIDGE_KEY=cambia-esto-tambien

# Opcional: fuerza la URL pública que se escribe dentro del loader.
# Útil si usas un dominio propio delante de Railway.
# PUBLIC_URL=https://mi-panel.up.railway.app

# Opcional: Place ID que aparece precargado en el panel.
DEFAULT_PLACE_ID=96342491571673
